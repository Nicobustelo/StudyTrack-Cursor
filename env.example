# =============================================================================
# StudyTrack — env.example
# =============================================================================
# Copiar este archivo como .env.local para desarrollo:
# cp env.example .env.local
#
# Reglas:
# - Nunca commitear .env.local ni claves reales.
# - Las variables NEXT_PUBLIC_* son visibles en el navegador.
# - Todas las claves privadas tienen que usarse solamente server-side.
# - En Vercel, cargar estas variables en Project Settings → Environment Variables.
# =============================================================================


# -----------------------------------------------------------------------------
# APP / NEXT.JS
# -----------------------------------------------------------------------------
# En producción, apuntar a la URL real de Vercel después del primer deploy.
# En Vercel, si no se define, se infiere de VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
# Crítico para: confirmación de email (Supabase), back_urls y webhooks de Mercado Pago.

NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# SUPABASE — AUTH / DATABASE / STORAGE
# -----------------------------------------------------------------------------
# Crear proyecto en Supabase y copiar:
# Project Settings → API → Project URL / anon key / service_role key.
#
# NEXT_PUBLIC_SUPABASE_* se puede exponer al cliente.
# SUPABASE_SERVICE_ROLE_KEY es privado y solo server-side.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Supabase → Authentication → URL Configuration (Dashboard):
# - Site URL: misma URL pública que NEXT_PUBLIC_APP_URL (NO dejar localhost en prod).
# - Redirect URLs: agregar estas dos (y tu dominio custom si aplica):
#   http://localhost:3000/auth/callback
#   https://<tu-dominio-vercel>/auth/callback


# -----------------------------------------------------------------------------
# OPENAI — SERVER SIDE ONLY
# -----------------------------------------------------------------------------
# Nunca usar OPENAI_API_KEY en el cliente.
# OPENAI_MODEL: usar un modelo mini (barato y rápido), verificado contra /v1/models.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini


# -----------------------------------------------------------------------------
# FILE PROCESSING / PDF / OCR
# -----------------------------------------------------------------------------

MAX_UPLOAD_FILES_FREE="5"
MAX_UPLOAD_FILES_PREMIUM="30"
MAX_UPLOAD_FILE_SIZE_MB="25"
MAX_TOTAL_UPLOAD_SIZE_MB="150"

# MIME types separados por coma.
ALLOWED_UPLOAD_MIME_TYPES="application/pdf,text/plain,text/markdown,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

OCR_ENABLED="false"
OCR_PROVIDER="none"

PDF_MAX_PAGES_PER_FILE="120"
PDF_EXTRACT_IMAGES="false"


# -----------------------------------------------------------------------------
# MERCADO PAGO — CHECKOUT PRO
# -----------------------------------------------------------------------------
# Crear aplicación en Mercado Pago Developers.
# Usar credenciales TEST para desarrollo y PROD para producción.
# El Access Token es privado y se usa server-side para crear preferencias.
# MERCADOPAGO_NOTIFICATION_URL se completa con la URL real de Vercel post-deploy.

MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_NOTIFICATION_URL=


# -----------------------------------------------------------------------------
# POSTHOG — ANALYTICS
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY se usa client-side (vía proxy /ingest).

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=


# -----------------------------------------------------------------------------
# PRECIOS — ARS (Checkout Pro)
# -----------------------------------------------------------------------------
# Montos en pesos argentinos, sin decimales.

NEXT_PUBLIC_PRICE_ONE_EXAM=5900
NEXT_PUBLIC_PRICE_THREE_EXAMS=12900
NEXT_PUBLIC_PRICE_SEMESTER=19900
